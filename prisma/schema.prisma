generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  APPROVER
  VIEWER
}

enum UserType {
  ADMIN    // System admins who can create users
  USER     // Regular users created by admins
}

